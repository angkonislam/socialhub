# ─────────────────────────────────────────────────────────────
# Social Hub — environment variables
# Copy this file to `.env.local` and fill in real values.
# Never commit `.env.local`. Set the same vars in Vercel for prod.
# ─────────────────────────────────────────────────────────────

# Auth.js (NextAuth) ------------------------------------------------
# Generate a secret with: npx auth secret  (or: openssl rand -base64 32)
AUTH_SECRET="replace-with-generated-secret"
# Base URL of the app. Locally http://localhost:3000.
# On Vercel this is set automatically; override only if needed.
AUTH_URL="http://localhost:3000"
# Trust the host header (required on Vercel / behind proxies).
AUTH_TRUST_HOST="true"

# OAuth providers (login) ------------------------------------------
# Google  — https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# GitHub  — https://github.com/settings/developers
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Facebook — https://developers.facebook.com/apps
AUTH_FACEBOOK_ID=""
AUTH_FACEBOOK_SECRET=""

# LinkedIn — https://www.linkedin.com/developers/apps
AUTH_LINKEDIN_ID=""
AUTH_LINKEDIN_SECRET=""

# TikTok — https://developers.tiktok.com/apps
AUTH_TIKTOK_ID=""
AUTH_TIKTOK_SECRET=""

# Supabase ----------------------------------------------------------
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Service-role key — server only. NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=""

# Feature flags -----------------------------------------------------
# When "true", platform connections + publishing use mock APIs so the
# app works end-to-end before real platform credentials are added.
NEXT_PUBLIC_USE_MOCK_APIS="true"

# Supabase Storage --------------------------------------------------
# Media uploads go to this bucket when Supabase is configured.
# Create a PUBLIC bucket named "media" in the Supabase dashboard.
# (No extra env var needed — uses the keys above.)

# ─────────────────────────────────────────────────────────────
# Social Hub — environment variables
# Copy to .env.local for local dev. Set same vars in Vercel dashboard for prod.
# Never commit .env.local
# ─────────────────────────────────────────────────────────────

# App URL — leave blank on Vercel (auto-detected). Set for local dev only.
# NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Supabase — https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Google OAuth (Login + YouTube connect)
# https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Facebook / Meta (Facebook Pages + Instagram connect)
# https://developers.facebook.com/apps
AUTH_FACEBOOK_ID=""
AUTH_FACEBOOK_SECRET=""
FACEBOOK_SCOPES="pages_show_list,business_management"

# Auth.js secret (generate: openssl rand -base64 32)
AUTH_SECRET=""
AUTH_TRUST_HOST="true"

# Mock APIs — set "true" to use mock data for platforms not yet connected
NEXT_PUBLIC_USE_MOCK_APIS="true"
